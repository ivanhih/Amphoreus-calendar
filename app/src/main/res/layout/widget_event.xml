<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_event_row" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="4dp" android:paddingEnd="4dp">
    <!-- 颜色都在 Widgets.render() 里按月设置，不在这里写死（写死金色会让卡片和当月主题色不一致）。 -->
    <TextView android:id="@+id/widget_event_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/widget_event_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout>
