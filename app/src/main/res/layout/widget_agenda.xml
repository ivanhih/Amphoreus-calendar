<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
    <!--
      插画是左侧一根竖条（内容宽的 40%，整条高，weight 4:6 与 core.WidgetBudget.AGENDA_ART_SHARE 一致）。
      竖条仍保持紧凑，但比旧版更宽，避免角色落在图片栏和日程栏的分界线上。
      旧版是 52dp 方块，同一张图只能露出高度的 15%。
    -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <ImageView android:id="@+id/widget_art" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="4" android:scaleType="fitCenter" android:contentDescription="当月插画"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="6" android:orientation="vertical" android:paddingStart="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="30dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end" android:textSize="15sp"/>
                <TextView android:id="@+id/widget_config" android:layout_width="30dp" android:layout_height="match_parent" android:gravity="center" android:text="⚙" android:textSize="15sp" android:contentDescription="配置卡片"/>
                <TextView android:id="@+id/widget_add" android:layout_width="34dp" android:layout_height="match_parent" android:gravity="center" android:text="＋" android:textSize="20sp" android:contentDescription="新建日程"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/widget_events" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"/>
            <TextView android:id="@+id/widget_footer" android:layout_width="match_parent" android:layout_height="16dp" android:textSize="9sp" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
