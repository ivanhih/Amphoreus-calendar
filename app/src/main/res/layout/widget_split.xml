<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/split_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp" android:background="@drawable/widget_background">
    <!-- 左侧是当月角色插画，右侧是独立的真实日期格；两列都随卡片宽度等比分配。 -->
    <LinearLayout android:id="@+id/split_body" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:baselineAligned="false">
        <ImageView android:id="@+id/split_art" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:scaleType="centerCrop" android:contentDescription="当月角色插画"/>
        <LinearLayout android:id="@+id/split_calendar" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:paddingStart="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/split_previous" android:layout_width="24dp" android:layout_height="match_parent" android:gravity="center" android:text="‹" android:textSize="17sp" android:contentDescription="上个月"/>
                <TextView android:id="@+id/split_title" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:textSize="11sp" android:contentDescription="回到本月"/>
                <TextView android:id="@+id/split_next" android:layout_width="24dp" android:layout_height="match_parent" android:gravity="center" android:text="›" android:textSize="17sp" android:contentDescription="下个月"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/split_weekdays" android:layout_width="match_parent" android:layout_height="18dp" android:orientation="horizontal"/>
            <LinearLayout android:id="@+id/split_grid" android:layout_width="match_parent" android:layout_height="120dp" android:orientation="vertical"/>
            <TextView android:id="@+id/split_footer" android:layout_width="match_parent" android:layout_height="16dp" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end" android:textSize="8sp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
